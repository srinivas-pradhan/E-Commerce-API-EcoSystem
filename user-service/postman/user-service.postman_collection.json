{
  "info": {
    "_postman_id": "5a6b6e04-40e3-4ef8-a982-3dca8614dd01",
    "name": "User Service",
    "description": "Auth0-backed user-service API checks. Set environment variables before running: base_url, auth0_domain, auth0_audience, postman_client_id, and postman_client_secret. The collection fetches and caches an Auth0 access token for the current request's required scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestScopes = {",
          "  'Service Status': 'read:service_status',",
          "  'Auth Config': 'read:auth_config',",
          "  'Current User': 'read:profile',",
          "  'Start Registration': 'create:registration',",
          "  'Complete Registration': 'complete:registration',",
          "  'Read Profile': 'read:own_profile',",
          "  'Update Profile': 'update:own_profile',",
          "  'Enroll MFA': 'enroll:own_mfa',",
          "  'Challenge MFA': 'challenge:own_mfa',",
          "  'Delete MFA Enrollment': 'delete:own_mfa',",
          "  'List Users': 'read:users',",
          "  'Read User': 'read:users',",
          "  'Update User Attributes': 'update:users',",
          "  'Create Password Reset Ticket': 'reset:passwords',",
          "  'Reset User MFA': 'reset:mfa',",
          "  'List Groups': 'read:groups',",
          "  'Create Group': 'create:groups',",
          "  'Add User To Group': 'update:groups',",
          "  'Remove User From Group': 'delete:groups'",
          "};",
          "",
          "const requiredScope = requestScopes[pm.info.requestName];",
          "if (!requiredScope) {",
          "  pm.environment.unset('access_token');",
          "  return;",
          "}",
          "",
          "if (!pm.variables.get('base_url')) {",
          "  throw new Error('Set base_url before running user-service requests.');",
          "}",
          "",
          "const tokenKey = 'access_token_' + requiredScope.replace(/[^a-zA-Z0-9]/g, '_');",
          "const tokenExpiryKey = tokenKey + '_expires_at';",
          "const tokenExpiresAt = Number(pm.environment.get(tokenExpiryKey) || 0);",
          "const cachedToken = pm.environment.get(tokenKey);",
          "if (cachedToken && tokenExpiresAt > Date.now() + 60000) {",
          "  pm.environment.set('access_token', cachedToken);",
          "  return;",
          "}",
          "",
          "const auth0Domain = pm.variables.get('auth0_domain');",
          "const audience = pm.variables.get('auth0_audience');",
          "const clientId = pm.variables.get('postman_client_id');",
          "const clientSecret = pm.variables.get('postman_client_secret');",
          "",
          "['auth0_domain', 'auth0_audience', 'postman_client_id', 'postman_client_secret'].forEach(function (key) {",
          "  if (!pm.variables.get(key)) {",
          "    throw new Error('Set ' + key + ' in the active Postman environment.');",
          "  }",
          "});",
          "",
          "pm.sendRequest({",
          "  url: 'https://' + auth0Domain + '/oauth/token',",
          "  method: 'POST',",
          "  header: {",
          "    'Content-Type': 'application/json'",
          "  },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({",
          "      grant_type: 'client_credentials',",
          "      client_id: clientId,",
          "      client_secret: clientSecret,",
          "      audience: audience,",
          "      scope: requiredScope",
          "    })",
          "  }",
          "}, function (error, response) {",
          "  if (error) {",
          "    throw error;",
          "  }",
          "  if (!response || response.code >= 400) {",
          "    throw new Error('Auth0 token request failed: ' + (response ? response.text() : 'no response'));",
          "  }",
          "  const body = response.json();",
          "  pm.environment.set('access_token', body.access_token);",
          "  pm.environment.set(tokenKey, body.access_token);",
          "  pm.environment.set(tokenExpiryKey, String(Date.now() + ((body.expires_in || 3600) * 1000)));",
          "  pm.environment.set('access_token_scope', requiredScope);",
          "});"
        ]
      }
    }
  ],
